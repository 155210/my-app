<?xml version="1.0" encoding="utf-8"?>
<!-- gproxy 默认跑在 http://127.0.0.1:8787，需要允许明文 http -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
